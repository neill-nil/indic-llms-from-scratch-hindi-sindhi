# Project requirements/docs
*.pdf
LMA_Individual_Project_v1.pdf
# ...except the final report, which is the graded Phase 3 deliverable and must be committed.
# Both spellings, so a rename of the compiled file does not silently re-ignore it.
!report/Final_Report.pdf
!report/final_report.pdf

# Virtual environment
.venv/

# Downloaded raw data (too large for git — upload to Google Drive)
hindi/data/collection/raw/
sindhi/data/collection/raw/

# Cleaned data (too large for git) - the corpora themselves live on Google Drive,
# but the small JSON statistics files beside them are graded deliverables.
hindi/data/preprocessed/*
sindhi/data/preprocessed/*
!hindi/data/preprocessed/*.json
!sindhi/data/preprocessed/*.json

# Tokenizer artifacts.
# The .model/.vocab files ARE committed: they are required Phase 1 deliverables
# and are small (<700 KB each). Only the huge intermediate training text is ignored.
hindi/tokenizer/train_clean.txt
sindhi/tokenizer/train_clean.txt

# Log files
*.log
# ...but the pretraining logs are a required Phase 2 deliverable: the brief states that
# training logs and loss curves must be in the branch, not on an external dashboard.
!hindi/train/run/train.log
!sindhi/train/run/train.log
nohup.out
# The tokenizer training.log files on disk are from a failed 32k BPE attempt on
# 15 Aug (0 sentences loaded), not from the runs that produced the shipped 16k
# models on 17-19 Aug. They are not committed because they document a crash, not
# the artefacts. Re-running run_tokenizer_*.sh regenerates real logs.

# Python cache
__pycache__/
*.pyc
*.pyo

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

# Model checkpoints (upload to Google Drive)
*.pt
*.pth
*.bin
*.safetensors

# Personal study notes — reference only, not part of the submission
PHASE2_STUDY_GUIDE.md
VIVA_GUIDE.md
# Phase 3 work log: the history of what was tried, reversed and fixed, kept so the
# work can be reconstructed later. The assessed narrative lives in the phase reports.
report/phase3_worklog.md
# AI-drafted Phase 3 report and report-writing pointers: kept as private reference only. The
# submitted report is a LaTeX PDF written by the student (TA instruction, 15 Sep), and the
# course runs an AI-plagiarism check on it, so this draft must not sit in the branch.
report/phase3.md
REPORT_POINTERS.md

# Phase 3 generated reasoning datasets (~98 MB across both languages).
# Not committed: they are fully reproducible from a seeded script, so the generator,
# the validated lexicons and the templates are the artifacts worth versioning.
#   python -m common.reasoning.generate
# dataset_statistics.json IS committed — it is small and is the evidence for the
# balance and leakage claims in the report.
*/finetune/data/*.jsonl

# Learning-rate probe completion markers. Only their existence matters, and only locally,
# so that re-running common.finetune.lr_probe skips finished runs. The committed
# training_log.jsonl already records that each run completed.
*/finetune/lr_probe/*/DONE
